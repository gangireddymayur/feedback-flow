<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="app.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.cjs" />
        </rule>
      </rules>
    </rewrite>

    <iisnode node_env="production" devErrorsEnabled="true" />
  </system.webServer>
</configuration>
