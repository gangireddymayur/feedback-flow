# ===== ReviewOS Backend =====
PORT=3001
NODE_ENV=production

# MySQL (create the DB in Plesk → Databases first)
DB_HOST=localhost
DB_PORT=3306
DB_USER=reviewos_user
DB_PASSWORD=changeme
DB_NAME=reviewos

# Auth — generate a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins. Use * during testing.
# Example for Lovable preview + production:
# CORS_ORIGINS=https://id-preview--xxxx.lovable.app,https://your-app.lovable.app
CORS_ORIGINS=*
